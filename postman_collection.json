{
  "info": {
    "name": "School Management API",
    "_postman_id": "a108f970-f4e3-4f45-853f-c469f340671e",
    "description": "Collection for addSchool and listSchools endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Add School",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Green Valley School\",\n  \"address\": \"123 Lake Road, Pune\",\n  \"latitude\": 18.5204,\n  \"longitude\": 73.8567\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/addSchool",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "addSchool"
          ]
        }
      }
    },
    {
      "name": "List Schools by Distance",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/listSchools?latitude=18.5204&longitude=73.8567",
          "host": [
            "https://school-management-system-api.up.railway.app/"
          ],
          "path": [
            "listSchools"
          ],
          "query": [
            {
              "key": "latitude",
              "value": "18.5204"
            },
            {
              "key": "longitude",
              "value": "73.8567"
            }
          ]
        }
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ]
}
